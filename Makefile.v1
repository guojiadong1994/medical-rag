.PHONY: test preflight run demo docker-up docker-down

test:
	pytest -q

preflight:
	python scripts/preflight_v1.py

run:
	python run.py

demo:
	@echo "Open http://127.0.0.1:8000/rag-demo"

docker-up:
	docker compose -f docker-compose.rag-v1.yml up --build

docker-down:
	docker compose -f docker-compose.rag-v1.yml down
