{
  "name": "hypertension_2024_retrieval_eval_v2",
  "version": "v2",
  "description": "中国高血压防治指南（2024年修订版）Evidence-level Retrieval Evaluation V2。支持一个问题对应多个可接受证据，不再把单一Chunk当作唯一正确答案。",
  "labeling_policy": "只要一个Chunk能够独立、明确支持问题所需事实，即可标为相关。优先用页码/章节/表题/术语/数值关系描述证据，不绑定易变化的chunk_id；同一问题可有多个evidence_rules。",
  "cases": [
    {
      "id": "htn_office_threshold",
      "query": "诊室血压达到多少可以诊断高血压？",
      "expected_facts": [
        "诊室血压",
        "收缩压≥140 mmHg和/或舒张压≥90 mmHg"
      ],
      "evidence_rules": [
        {
          "rule_id": "office_summary_definition",
          "description": "要点4或4.5.1正文中的诊断定义。",
          "page_ranges": [
            [
              10,
              11
            ]
          ],
          "section_contains_any": [
            "要点4",
            "4.5.1"
          ],
          "required_keywords": [
            "诊室血压",
            "140/90"
          ]
        },
        {
          "rule_id": "office_table6_classification",
          "description": "表6直接给出基于诊室血压的高血压阈值。",
          "content_types": [
            "table"
          ],
          "table_title_contains_any": [
            "表6",
            "基于诊室血压的血压分类和高血压分级"
          ],
          "required_keywords": [
            "高血压",
            "≥140",
            "≥90"
          ],
          "proximity_groups": [
            {
              "keywords": [
                "高血压",
                "≥140",
                "≥90"
              ],
              "max_chars": 90
            }
          ]
        },
        {
          "rule_id": "office_table7_diagnostic_standard",
          "description": "表7中的诊室血压诊断标准。",
          "content_types": [
            "table"
          ],
          "table_title_contains_any": [
            "表7",
            "高血压诊断标准"
          ],
          "required_keywords": [
            "诊室血压",
            "≥140",
            "≥90"
          ]
        }
      ]
    },
