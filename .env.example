# ===== 应用 =====
APP_NAME=medical-rag
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 本地演示账号。生产环境不要使用默认密码和固定令牌。
DOCTOR_USERNAME=doctor
DOCTOR_PASSWORD=123456
ACCESS_TOKEN=medical-rag-doctor-session

# ===== RAG 运行文件 =====
RAG_CHUNKS_PATH=data/processed/hypertension_2024/chunks.json
RAG_EMBEDDINGS_PATH=data/processed/hypertension_2024/embeddings.npy
RAG_MANIFEST_PATH=data/processed/hypertension_2024/embedding_manifest.json

# dense_backend（向量检索后端）：本地产品默认 local，避免 macOS 下 MPS 与 Milvus Lite 的原生运行时冲突。
# local=使用本地 NumPy 精确检索；milvus=服务器/Linux 环境可切换 Milvus 向量数据库。
RAG_DENSE_BACKEND=local
RAG_MILVUS_URI=data/milvus/medical_rag.db
RAG_MILVUS_COLLECTION=medical_rag_chunks_v1
# RAG_MILVUS_TOKEN=

# ===== 本地检索模型 =====
RAG_EMBEDDING_MODEL=BAAI/bge-m3
# 留空代表让 Sentence Transformers（句向量模型库）自动选择 CPU / CUDA / MPS。
# RAG_EMBEDDING_DEVICE=
RAG_EMBEDDING_BATCH_SIZE=8

RAG_RERANKER_MODEL=BAAI/bge-reranker-base
# auto=自动选择 CUDA、MPS 或 CPU。
RAG_RERANKER_DEVICE=auto
RAG_RERANKER_BATCH_SIZE=4
RAG_RERANKER_MAX_LENGTH=512

# ===== 检索参数 =====
RAG_CANDIDATE_K=50
RAG_RRF_K=60
RAG_RERANK_K=20
RAG_CONTEXT_TOP_K=5
RAG_MAX_CONTEXT_CHARS=6000

# ===== 大模型接口 =====
# OpenAI-compatible（OpenAI兼容接口）：只要接口协议兼容，就可接云端模型或以后本地vLLM服务。
MEDICAL_RAG_LLM_BASE_URL=https://your-llm-endpoint.example/v1
MEDICAL_RAG_LLM_MODEL=qwen3.7-max
MEDICAL_RAG_LLM_API_KEY=
MEDICAL_RAG_LLM_TEMPERATURE=0
MEDICAL_RAG_LLM_MAX_OUTPUT_TOKENS=768
MEDICAL_RAG_LLM_TIMEOUT_SECONDS=90
